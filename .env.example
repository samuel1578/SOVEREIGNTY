# Reset to Sovereignty — environment contract (SRS §18). Copy to .env.local; never commit real values.
# Scope: Public = NEXT_PUBLIC_* (shipped to the browser) · Server = server-only.

# --- Site / mock frontend ---------------------------------------------------
# Public · canonical origin, e.g. https://resettosovereignty.com
NEXT_PUBLIC_SITE_URL=
# Public · 'false' disables the mock service layer (default: mocks on)
NEXT_PUBLIC_USE_MOCKS=
# Public · '1' = review mode: role switcher, MFA mock, review-only prices (D4). Leave empty in production.
NEXT_PUBLIC_REVIEW=

# --- Supabase (auth + data) -------------------------------------------------
# Public · Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Public · client and anonymous reads
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server · webhook, staff invite, jobs
SUPABASE_SECRET_KEY=

# --- Cloudflare R2 (audio storage) — Server ---------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Stripe (payments + tax) — Server ---------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cal.com (coaching) -----------------------------------------------------
# Public · default coaching event and booking fallback (the CMS link overrides it)
NEXT_PUBLIC_CAL_LINK=

# --- Security / ops — Server ------------------------------------------------
# IP hashing for rate limits
RATE_LIMIT_SALT=
# Ops alerts recipient and the SMTP/API key used to send them
ALERT_EMAIL_TO=
ALERT_EMAIL_API_KEY=

# --- Analytics (provider TBC) — Public: NEXT_PUBLIC_ANALYTICS_* per provider -
NEXT_PUBLIC_ANALYTICS_ID=

# --- Transcription (speech-to-text provider TBC) — Server -------------------
TRANSCRIBE_API_KEY=
TRANSCRIBE_WEBHOOK_SECRET=

# SMTP credentials for auth emails are configured in the Supabase dashboard, not in the app.
